{
    "name": "devsecops/vulnerable-php-app",
    "description": "Intentionally vulnerable PHP application for testing security CI/CD workflows (Frogbot, JFrog SAST, OSSF Scorecard, Synopsys, SonarQube, Semgrep). DO NOT DEPLOY.",
    "type": "project",
    "license": "MIT",
    "keywords": ["security", "testing", "devsecops", "intentionally-vulnerable"],
    "require": {
        "php": ">=7.2",
        "phpmailer/phpmailer": "5.2.16",
        "monolog/monolog": "1.11.0",
        "guzzlehttp/guzzle": "6.2.0",
        "twig/twig": "1.35.0",
        "symfony/http-foundation": "2.8.0",
        "league/flysystem": "1.0.0",
        "firebase/php-jwt": "3.0.0",
        "smarty/smarty": "3.1.32",
        "erusev/parsedown": "1.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "4.8.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
